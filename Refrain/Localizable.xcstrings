      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основные"
          }
        }
      }
    },
    "Give it a name, an address and a model." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите название, адрес и модель."
