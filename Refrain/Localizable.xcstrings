    "Refrain — transcribing" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refrain — идёт расшифровка"
          }
        }
      }
    },
    "Runs on the Neural Engine. Far more accurate than Apple's older model in these languages; Russian makes less than half the mistakes. Pretype shares the same copy." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает на Neural Engine. На этих языках гораздо точнее старой модели Apple: в русском ошибок в два с лишним раза меньше. Pretype использует ту же копию."
          }
        }
      }
    },
    "Settings…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки…"
          }
        }
      }
    },
    "Speakers" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голоса"
          }
        }
      }
