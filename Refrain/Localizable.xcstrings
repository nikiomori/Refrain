          }
        }
      }
    },
    "Turns the speech in an audio or video file into text, on this Mac." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превращает речь из аудио- или видеофайла в текст прямо на этом Mac."
          }
        }
      }
    },
    "Update to Refrain %@" : {
      "localizations" : {
