    "Status" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Состояние"
          }
        }
      }
    },
    "System" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системная"
          }
        }
      }
    },
    "Tells voices apart for apps that ask who said what, like Reprise with several people on a call. 22 MB, on the Neural Engine." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Различает голоса для приложений, которым нужно знать, кто что сказал: например, Reprise, когда на звонке несколько собеседников. 22 МБ, работает на Neural Engine."
          }
        }
      }
    },
    "The download doesn't have the signature of this copy of Refrain. Download the update from GitHub." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У загрузки не та подпись, что у этой копии Refrain. Скачайте обновление с GitHub."
          }
        }
      }
    },
    "The download failed. Try again later." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка не удалась. Повторите попытку позже."
          }
        }
      }
    },
    "This is the latest version." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это последняя версия."
          }
        }
      }
    },
    "This release has no app to download." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом выпуске нет приложения для загрузки."
