    "Download" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачать"
          }
        }
      }
    },
    "Download Parakeet (630 MB)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачать Parakeet (630 МБ)"
          }
        }
      }
    },
    "Downloaded" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачано"
          }
        }
      }
    },
    "Downloaded — %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачано — %@"
          }
        }
      }
    },
    "English, German, French, Spanish, Japanese, Chinese and two dozen more use Apple's models, which macOS already has or downloads by itself. For Russian, Ukrainian, Polish, Czech and other European languages, Parakeet is far more accurate." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Английский, немецкий, французский, испанский, японский, китайский и ещё два десятка языков распознают модели Apple: они уже есть в macOS, или она скачает их сама. Для русского, украинского, польского, чешского и других европейских языков гораздо точнее Parakeet."
          }
        }
      }
    },
    "Every other language macOS can dictate." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все остальные языки, которые знает диктовка macOS."
          }
        }
      }
    },
    "File" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл"
          }
        }
      }
    },
