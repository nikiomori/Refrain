    },
    "Parakeet is downloaded" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet скачан"
          }
        }
      }
    },
    "Point Reprise, VoiceInk or your scripts here. Any model name, no key." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите этот адрес в Reprise, VoiceInk или своих скриптах. Модель любая, ключ не нужен."
          }
        }
      }
    },
    "Port" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порт"
          }
        }
      }
    },
    "Port %@ is used by another app." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порт %@ занят другим приложением."
          }
        }
      }
    },
    "Quit Refrain" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершить Refrain"
          }
        }
      }
    },
    "Ready" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готов"
          }
        }
      }
    },
    "Refrain is your Mac's hearing" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refrain — слух вашего Mac"
          }
        }
      }
    },
    "Refrain — transcribing" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refrain — идёт расшифровка"
          }
        }
      }
    },
    "Remove" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить"
          }
        }
      }
    },
    "Runs on the Neural Engine. Far more accurate than Apple's older model in these languages; Russian makes less than half the mistakes. Pretype shares the same copy." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает на Neural Engine. На этих языках гораздо точнее старой модели Apple: в русском ошибок в два с лишним раза меньше. Pretype использует ту же копию."
          }
        }
      }
    },
    "Services" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервисы"
          }
        }
      }
    },
    "Settings…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки…"
          }
        }
      }
    },
    "Speakers" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голоса"
          }
        }
      }
    },
    "Status" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Состояние"
          }
        }
      }
    },
    "System" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системная"
          }
        }
      }
    },
    "Tells voices apart for apps that ask who said what, like Reprise with several people on a call. 22 MB, on the Neural Engine." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Различает голоса для приложений, которым нужно знать, кто что сказал: например, Reprise, когда на звонке несколько собеседников. 22 МБ, работает на Neural Engine."
          }
        }
      }
    },
    "Transcribe ${file}" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифровать ${file}"
          }
        }
      }
    },
    "Transcribe Audio File" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифровать аудиофайл"
          }
        }
      }
    },
    "Transcribing — %@ of %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифровка — %@ из %@"
          }
        }
      }
    },
    "Transcribing — %@ of %@, %lld waiting" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифровка — %@ из %@, ещё %lld в очереди"
          }
        }
      }
    },
    "Turns the speech in an audio or video file into text, on this Mac." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превращает речь из аудио- или видеофайла в текст прямо на этом Mac."
          }
        }
      }
    },
    "Welcome to Refrain" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добро пожаловать в Refrain"
          }
        }
      }
    },
    "While Transcribing" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время расшифровки"
          }
        }
      }
